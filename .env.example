# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAZORPAY PAYMENT GATEWAY (Optional for live/test Razorpay API calls)
# If not configured, CampusCrave operates in a clearly labeled Realistic Test/Sandbox Mode
# with UPI, Cards, NetBanking simulation and server-side signature validation.
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# SUPABASE POSTGRESQL DATABASE & AUTH (Optional / Live Integration)
# Configure your Supabase project credentials from Project Settings > API:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
